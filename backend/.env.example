# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/shopease
DB_POOL_MAX=20        # max DB connections per worker (20 × CPU cores = total)
DB_POOL_MIN=2         # keep-warm connections

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_64_byte_random_hex_string
JWT_EXPIRY=8h

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://yourshop.example.com
# Comma-separated list for multiple origins:
# ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com

# ── Email (Nodemailer / Gmail SMTP) ──────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_gmail_app_password   # Gmail App Password (not your main password)
FROM_EMAIL=ShopEase Reports <your@gmail.com>

# Legacy Gmail keys (kept for backward compat)
GMAIL_USER=your@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password

# ── SMS (MSG91 for OTP) ───────────────────────────────────────────────────────
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_TEMPLATE_ID=your-template-id

# ── Optional: Redis (for multi-server OTP store and token blacklist) ──────────
# REDIS_URL=redis://localhost:6379
